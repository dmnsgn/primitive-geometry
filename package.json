    "cylinder",
    "cone",
    "capsule",
    "torus",
    "prism",
    "polyhedron",
    "platonic-solid",
    "tetrahedron",
    "icosahedron",
    "dodecahedron",
    "icosphere",
    "geodesic"
  ],
  "homepage": "https://github.com/dmnsgn/primitive-geometry",
